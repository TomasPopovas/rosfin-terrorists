# Скопируйте в .env и заполните своими данными от личного кабинета portal.fedsfm.ru
ROSFIN_LOGIN=your_login
ROSFIN_PASS=your_password

# Необязательные параметры (значения по умолчанию)
# ROSFIN_INTERVAL=12h
# ROSFIN_FORMATS=xml,doc
# ROSFIN_OUTPUT_DIR=/data
# ROSFIN_TIMEOUT=3m
# ROSFIN_ATTEMPTS=3
# ROSFIN_KEEP_RUNS=0
# ROSFIN_EXTRACT=true
# ROSFIN_MARK_NOTIFICATIONS=true
# ROSFIN_LATEST_LINK=true
