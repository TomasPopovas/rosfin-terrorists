# Скопируйте этот файл в .env (рядом с docker-compose.yml) и заполните.
# .env указан в .gitignore — в репозиторий он не попадает. Не коммитьте его.

# --- Личный кабинет portal.fedsfm.ru (обязательно) ---
# Те же логин и пароль, которыми вы входите в кабинет в браузере.
ROSFIN_LOGIN=ваш_логин_кабинета
ROSFIN_PASS=ваш_пароль_кабинета

# --- Почтовые уведомления (необязательно) ---
# Если не заполнить хотя бы одно из HOST / USER / PASS / MAIL_TO,
# письма просто не отправляются, скачивание работает как обычно.

# Имя почтового сервера: используется для TLS (проверка сертификата) и HELO.
ROSFIN_SMTP_HOST=mail.example.ru
# Адрес, по которому реально подключаться (например, внутренний IP сервера
# в локальной сети). Пусто — подключаемся по ROSFIN_SMTP_HOST.
ROSFIN_SMTP_ADDR=
# 587 — STARTTLS (рекомендуется), 25 — без шифрования.
ROSFIN_SMTP_PORT=587
# Ящик-отправитель и пароль от него.
ROSFIN_SMTP_USER=robot@example.ru
ROSFIN_SMTP_PASS=пароль_от_ящика_отправителя
# Кому слать отчёты.
ROSFIN_MAIL_TO=team@example.ru
